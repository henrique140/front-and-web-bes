<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="./styles/global.css">
  <link rel="icon" href="./images/block.png" type="image/x-icon">
  <title>Conhecendo os displays</title>
</head>
<body>
  <header>
    <h1>Conhecendo os displays do CSS</h1>
  </header>
  <main>
    <section>
      <h2>Display block</h2>
      <div class="container-block">
        <div class="item">Item 1</div>
        <div class="item">Item 2</div>
        <div class="item">Item 3</div>
      </div>
      <p>Elementos são blocos que ocupam a linha toda por padrão</p>
    </section>

    <section>
      <h2>Display inline</h2>
      <div class="container-inline">
        <div class="item">Item 1</div>
        <div class="item">Item 2</div>
        <div class="item">Item 3</div>
      </div>
      <p>Elementos ficam em linha e respeitam o conteúdo textual</p>
    </section>

    <section>
      <h2>Display inline-block</h2>
      <div class="container-inline-block">
        <div class="item">Item 1</div>
        <div class="item">Item 2</div>
        <div class="item">Item 3</div>
      </div>
      <p>Elementos ficam em linha, mas se comportam como blocos</p>
    </section>

    <section>
      <h2>Display flex</h2>
      <div class="container-flex">
        <div class="item">Item 1</div>
        <div id="item-2" class="item">Item 2</div>
        <div id="item-3" class="item">Item 3</div>
        <div class="item">Item 4</div>
        <div class="item">Item 5</div>
        <div class="item">Item 6</div>
      </div>  
      <p>Elementos ficam flexivéis e se organizam em uma direção</p>
    </section>
    
    <section>
      <h2>Display grid</h2>
      <div class="container-grid">
        <div class="item">Item 1</div>
        <div class="item">Item 2</div>
        <div class="item">Item 3</div>
        <div class="item">Item 4</div>
        <div class="item">Item 5</div>
        <div class="item">Item 6</div>
        <div class="item">Item 7</div>
        <div class="item">Item 8</div>
        <div class="item">Item 9</div>
      </div>  
      <p>Elementos ficam posicionados em linhas e colunas</p>
    </section>

    <section>
      <h2>Display grid area</h2>
      <div class="container-grid-area">
        <div class="item item-cabecalho">Cabeçalho</div>
        <div class="item item-principal">Principal</div>
        <div class="item item-artigo">Artigo</div>
        <div class="item item-rodape">Rodapé</div>
      </div>
      <p>Elementos ficam posicionados em linhas e colunas nomeadas</p>
    </section>

  </main>
  <footer>
    <p>Projeto de compreensão de displays no CSS</p>
  </footer>
</body>
</html>